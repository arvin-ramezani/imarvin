{
  "name": "imarvin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config=vitest.config.ts",
    "test:integration": "node --import ./scripts/load-test-env.mjs ./node_modules/vitest/vitest.mjs run --config=vitest.integration.config.ts",
    "test:e2e": "node --import ./scripts/load-test-env.mjs --conditions=react-server ./node_modules/@playwright/test/cli.js test",
    "test:db:prepare": "node ./scripts/prepare-test-db.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "auth:generate": "auth generate --config ./auth.cli.ts --yes",
    "auth:check": "auth check --config ./auth.cli.ts",
    "test:e2e:ci": "node --import ./scripts/load-test-env.mjs --conditions=react-server ./node_modules/@playwright/test/cli.js test --config=playwright.ci.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@better-auth/prisma-adapter": "1.7.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.7",
    "dotenv": "18.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "prisma": "7.10.0",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
